{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Развилка",
  "mainBinaryName": "razvilka",
  "version": "1.1.0",
  "identifier": "io.github.liinkon.razvilka",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node copy-web.js",
    "beforeDevCommand": "node copy-web.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Развилка",
        "width": 1400,
        "height": 900,
        "minWidth": 480,
        "minHeight": 400,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#14161b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Схемы ветвящихся сценариев для ДнД",
    "longDescription": "Развилка — бесконечный холст для подготовки партий: сцены, руты, проверки, заметки, экспорт в Word.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"]
      }
    }
  }
}
